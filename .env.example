# ===================================================
# Environment Variables for Nasir Amme Portfolio
# ===================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local to version control.
# ===================================================

# Public site URL (used for SEO metadata, sitemap, Open Graph)
# Set to your deployed Vercel URL after first deployment.
NEXT_PUBLIC_SITE_URL=https://nasir-amme-portfolio.vercel.app

# ===================================================
# Contact Form — Resend Email Delivery
# ===================================================
# Sign up at https://resend.com and create an API key.
# The key must remain server-side only (no NEXT_PUBLIC_ prefix).
RESEND_API_KEY=re_your_resend_api_key_here

# The inbox address where contact form messages are delivered.
# Must match a verified domain or the Resend onboarding address.
CONTACT_EMAIL=nasiramme1511@gmail.com

# ===================================================
# GitHub API Integration
# ===================================================
# Optional — increases rate limit from 60 to 5000 requests/hour.
# Create a fine-grained personal access token with read-only
# public repository access at: https://github.com/settings/tokens
# Must remain server-side only (no NEXT_PUBLIC_ prefix).
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
